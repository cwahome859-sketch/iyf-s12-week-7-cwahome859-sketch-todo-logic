
``````javascript

import { describe, it, expect } from "vitest";


import {
    addTodo,
    deleteTodo,
    toggleTodo,
    filterTodos,
    clearCompleted,
    countRemaining,
    countCompleted
} from "../js/todo-logic.js";


const sampleTodos = [
    {
        id: 1,
        text: "Learn JavaScript",
        completed: false
    },
    {
        id: 2,
        text: "Practice HTML",
        completed: true
    },
    {
        id: 3,
        text: "Learn CSS",
        completed: false
    }
];

describe("To-Do List Logic", () => {

   
    describe("addTodo()", () => {

        it("should add a new task", () => {
            const result = addTodo(
                sampleTodos,
                "Learn React",
                4
            );

            expect(result).toHaveLength(4);

            expect(result[3]).toEqual({
                id: 4,
                text: "Learn React",
                completed: false
            });
        });

        it("should remove extra spaces from task text", () => {
            const result = addTodo(
                sampleTodos,
                "  Learn React  ",
                4
            );

            expect(result[3].text).toBe("Learn React");
        });

        it("should not modify the original array", () => {
            const result = addTodo(
                sampleTodos,
                "Learn React",
                4
            );

            expect(result).not.toBe(sampleTodos);
            expect(sampleTodos).toHaveLength(3);
        });
    });

   
    describe("deleteTodo()", () => {

        it("should delete a task by ID", () => {
            const result = deleteTodo(sampleTodos, 2);

            expect(result).toHaveLength(2);

            expect(
                result.find(todo => todo.id === 2)
            ).toBeUndefined();
        });

        it("should return all tasks if ID does not exist", () => {
            const result = deleteTodo(sampleTodos, 10);

            expect(result).toEqual(sampleTodos);
        });
    });

    
    describe("toggleTodo()", () => {

        it("should mark an active task as completed", () => {
            const result = toggleTodo(sampleTodos, 1);

            expect(result[0].completed).toBe(true);
        });

        it("should mark a completed task as active", () => {
            const result = toggleTodo(sampleTodos, 2);

            expect(result[1].completed).toBe(false);
        });

        it("should not modify the original tasks", () => {
            const result = toggleTodo(sampleTodos, 1);

            expect(sampleTodos[0].completed).toBe(false);
            expect(result).not.toBe(sampleTodos);
        });
    });

    
    describe("filterTodos()", () => {

        it("should return all tasks", () => {
            const result = filterTodos(sampleTodos, "all");

            expect(result).toHaveLength(3);
        });

        it("should return only active tasks", () => {
            const result = filterTodos(sampleTodos, "active");

            expect(result).toHaveLength(2);

            expect(
                result.every(todo => !todo.completed)
            ).toBe(true);
        });

        it("should return only completed tasks", () => {
            const result = filterTodos(sampleTodos, "completed");

            expect(result).toHaveLength(1);

            expect(result[0].completed).toBe(true);
        });
    });

    
    describe("clearCompleted()", () => {

        it("should remove all completed tasks", () => {
            const result = clearCompleted(sampleTodos);

            expect(result).toHaveLength(2);

            expect(
                result.every(todo => !todo.completed)
            ).toBe(true);
        });

        it("should return an empty array when all tasks are completed", () => {
            const completedTodos = [
                { id: 1, text: "Task one", completed: true }
            ];

            expect(clearCompleted(completedTodos)).toEqual([]);
        });
    });

    
    describe("Task counters", () => {

        it("should count remaining tasks", () => {
            expect(countRemaining(sampleTodos)).toBe(2);
        });

        it("should count completed tasks", () => {
            expect(countCompleted(sampleTodos)).toBe(1);
        });
    });

});
